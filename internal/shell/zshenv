# Generated by wate: restore the user's ZDOTDIR, run their zshenv, then load wate's integration
# from .zshrc time (after .zshrc would be too late for p10k, so we hook zshrc loading here).
if [[ -n $WATE_ZDOTDIR_ORIG ]]; then
  ZDOTDIR=$WATE_ZDOTDIR_ORIG
else
  unset ZDOTDIR
fi
unset WATE_ZDOTDIR_ORIG
[[ -r ${ZDOTDIR:-$HOME}/.zshenv ]] && source "${ZDOTDIR:-$HOME}/.zshenv"
# Load the integration before the user's .zshrc so p10k sees the setting.
[[ -o interactive ]] && source "__WATE_SHELL_DIR__/wate.zsh"
