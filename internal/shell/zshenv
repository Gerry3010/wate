# Generated by yate: restore the user's ZDOTDIR, run their zshenv, then load yate's integration
# from .zshrc time (after .zshrc would be too late for p10k, so we hook zshrc loading here).
if [[ -n $YATE_ZDOTDIR_ORIG ]]; then
  ZDOTDIR=$YATE_ZDOTDIR_ORIG
else
  unset ZDOTDIR
fi
unset YATE_ZDOTDIR_ORIG
[[ -r ${ZDOTDIR:-$HOME}/.zshenv ]] && source "${ZDOTDIR:-$HOME}/.zshenv"
# Load the integration before the user's .zshrc so p10k sees the setting.
[[ -o interactive ]] && source "__YATE_SHELL_DIR__/yate.zsh"
