<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="yate"
        Arguments=""
        InstallLocation="C:\Program Files\Gerald Hofbauer\yate">
    </Installer>
    <PackageInformation
        PackageName="yate"
        PackageDisplayName="yate"
        PublisherName="CN=Gerald Hofbauer"
        PublisherDisplayName="Gerald Hofbauer"
        Version="0.1.0.0"
        PackageDescription="yet another terminal emulator">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.gerry3010.yate"
                Description="yet another terminal emulator"
                DisplayName="yate"
                ExecutableName="yate"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>yate</DisplayName>
            <PublisherDisplayName>Gerald Hofbauer</PublisherDisplayName>
            <Description>yet another terminal emulator</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="yate.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
